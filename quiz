<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Quiz Interativo — Geografia, História, Língua Portuguesa e Arte</title>
  <style>
    :root {
      --bg-page: #f4f6fb;
      --bg-card: #ffffff;
      --bg-subtle: #f8fafc;
      --text-main: #0f172a;
      --text-secondary: #475569;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --primary-soft: #eef2ff;
      --primary-border: #c7d2fe;
      --success: #059669;
      --success-bg: #ecfdf5;
      --success-border: #6ee7b7;
      --success-text: #064e3b;
      --danger: #e11d48;
      --danger-bg: #fff1f2;
      --danger-border: #fda4af;
      --danger-text: #881337;
      --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
      --shadow-md: 0 10px 25px -5px rgba(15, 23, 42, 0.06), 0 8px 10px -6px rgba(15, 23, 42, 0.04);
      --radius-lg: 18px;
      --radius-md: 12px;
      --radius-sm: 8px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-page);
      color: var(--text-main);
      line-height: 1.55;
      min-height: 100vh;
      padding: 20px 16px 40px;
      -webkit-font-smoothing: antialiased;
    }

    .app-wrapper {
      max-width: 860px;
      margin: 0 auto;
    }

    /* Cabeçalho */
    .header-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 18px;
    }

    .header-top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .brand-box {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-icon {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-md);
      background: var(--primary);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .brand-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.01em;
    }

    .brand-subtitle {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .header-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
    }

    .score-pill {
      background: var(--bg-subtle);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 6px 14px;
      text-align: right;
    }

    .score-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .score-value {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--text-main);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 600;
      padding: 10px 15px;
      border-radius: var(--radius-md);
      border: 1px solid transparent;
      cursor: pointer;
      transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
      user-select: none;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-soft {
      background: var(--primary-soft);
      color: var(--primary);
      border-color: var(--primary-border);
    }

    .btn-soft:hover {
      background: #e0e7ff;
    }

    .btn-neutral {
      background: #f1f5f9;
      color: #334155;
      border-color: var(--border-color);
    }

    .btn-neutral:hover {
      background: #e2e8f0;
    }

    .btn-outline {
      background: #ffffff;
      color: #334155;
      border-color: var(--border-color);
    }

    .btn-outline:hover {
      background: var(--bg-subtle);
      border-color: #cbd5e1;
    }

    .btn-primary {
      background: var(--primary);
      color: #ffffff;
      padding: 12px 22px;
      font-size: 0.95rem;
      box-shadow: 0 2px 6px rgba(79, 70, 229, 0.25);
    }

    .btn-primary:hover {
      background: var(--primary-hover);
    }

    /* Abas de Filtro */
    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid var(--border-color);
    }

    .filter-tab {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 13px;
      border-radius: 999px;
      border: 1px solid var(--border-color);
      background: #ffffff;
      color: var(--text-secondary);
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .filter-tab:hover {
      background: var(--bg-subtle);
      color: var(--text-main);
    }

    .filter-tab.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #ffffff;
    }

    .filter-count {
      padding: 1px 7px;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      background: #f1f5f9;
      color: var(--text-muted);
    }

    .filter-tab.active .filter-count {
      background: rgba(255, 255, 255, 0.22);
      color: #ffffff;
    }

    /* Progresso */
    .progress-section {
      margin-bottom: 18px;
    }

    .progress-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.84rem;
      font-weight: 600;
      color: var(--text-secondary);
      margin-bottom: 8px;
    }

    .progress-track {
      width: 100%;
      height: 10px;
      background: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: var(--primary);
      border-radius: 999px;
      transition: width 0.25s ease;
    }

    /* Card Principal da Questão / Resumo */
    .main-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 26px 24px;
      box-shadow: var(--shadow-md);
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .fade-in {
      animation: fadeIn 0.22s ease-out;
    }

    .question-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 16px;
    }

    .badge-group {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }

    .subject-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 700;
      border: 1px solid transparent;
    }

    .subject-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    .subj-geo { background: #ecfdf5; color: #065f46; border-color: #a7f3d0; }
    .subj-geo .subject-dot { background: #10b981; }

    .subj-hist { background: #fffbeb; color: #92400e; border-color: #fde68a; }
    .subj-hist .subject-dot { background: #f59e0b; }

    .subj-port { background: #eff6ff; color: #1e40af; border-color: #bfdbfe; }
    .subj-port .subject-dot { background: #3b82f6; }

    .subj-arte { background: #fdf2f8; color: #9d174d; border-color: #fbcfe8; }
    .subj-arte .subject-dot { background: #ec4899; }

    .chapter-label {
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--text-muted);
    }

    .question-number-tag {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-muted);
    }

    .question-text {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text-main);
      line-height: 1.5;
      margin-bottom: 22px;
    }

    /* Opções */
    .options-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .option-btn {
      width: 100%;
      text-align: left;
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 15px 16px;
      border-radius: var(--radius-md);
      border: 2px solid var(--border-color);
      background: #ffffff;
      color: var(--text-main);
      font-family: inherit;
      font-size: 0.95rem;
      line-height: 1.5;
      cursor: pointer;
      transition: border-color 0.15s ease, background-color 0.15s ease, transform 0.1s ease;
    }

    .option-btn:not(:disabled):hover {
      border-color: var(--primary);
      background: #f5f7ff;
    }

    .option-btn:not(:disabled):active {
      transform: scale(0.995);
    }

    .option-btn:disabled {
      cursor: default;
    }

    .option-letter {
      width: 32px;
      height: 32px;
      border-radius: var(--radius-sm);
      background: #f1f5f9;
      color: #334155;
      font-weight: 800;
      font-size: 0.88rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    .option-btn:not(:disabled):hover .option-letter {
      background: var(--primary);
      color: #ffffff;
    }

    .option-content {
      flex: 1;
      padding-top: 3px;
      font-weight: 500;
    }

    .option-status-icon {
      flex-shrink: 0;
      font-weight: 800;
      font-size: 1.05rem;
      padding-top: 3px;
    }

    /* Estados Pós-Resposta */
    .option-btn.opt-correct {
      border-color: var(--success);
      background: var(--success-bg);
      color: var(--success-text);
    }

    .option-btn.opt-correct .option-letter {
      background: var(--success);
      color: #ffffff;
    }

    .option-btn.opt-wrong {
      border-color: var(--danger);
      background: var(--danger-bg);
      color: var(--danger-text);
    }

    .option-btn.opt-wrong .option-letter {
      background: var(--danger);
      color: #ffffff;
    }

    .option-btn.opt-muted {
      background: #f8fafc;
      border-color: #e2e8f0;
      color: #64748b;
      opacity: 0.78;
    }

    /* Caixa de Explicação */
    .explanation-box {
      margin-top: 22px;
      padding: 18px 20px;
      border-radius: var(--radius-md);
      border: 1px solid transparent;
      animation: fadeIn 0.22s ease-out;
    }

    .explanation-box.exp-correct {
      background: var(--success-bg);
      border-color: var(--success-border);
      color: var(--success-text);
    }

    .explanation-box.exp-wrong {
      background: var(--danger-bg);
      border-color: var(--danger-border);
      color: var(--danger-text);
    }

    .explanation-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }

    .explanation-pill {
      font-size: 0.74rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 3px 10px;
      border-radius: 999px;
      color: #ffffff;
    }

    .exp-correct .explanation-pill {
      background: var(--success);
    }

    .exp-wrong .explanation-pill {
      background: var(--danger);
    }

    .explanation-title {
      font-size: 0.98rem;
      font-weight: 800;
    }

    .explanation-body {
      font-size: 0.92rem;
      line-height: 1.55;
    }

    /* Navegação Inferior */
    .card-footer {
      margin-top: 26px;
      padding-top: 18px;
      border-top: 1px solid var(--border-color);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .hint-text {
      font-size: 0.85rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    /* Tela de Resumo Final */
    .summary-hero {
      text-align: center;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border-color);
    }

    .summary-badge {
      display: inline-block;
      padding: 5px 14px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      background: var(--primary-soft);
      color: var(--primary);
      margin-bottom: 12px;
    }

    .summary-title {
      font-size: 1.65rem;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 8px;
    }

    .summary-desc {
      font-size: 0.95rem;
      color: var(--text-secondary);
      max-width: 580px;
      margin: 0 auto 20px;
    }

    .stats-grid {
      display: inline-flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      background: var(--bg-subtle);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 16px 28px;
      margin-bottom: 22px;
    }

    .stat-item {
      min-width: 72px;
    }

    .stat-label {
      display: block;
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
    }

    .stat-num {
      font-size: 1.55rem;
      font-weight: 800;
    }

    .stat-green { color: var(--success); }
    .stat-red { color: var(--danger); }
    .stat-dark { color: var(--text-main); }

    .summary-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
    }

    .section-heading {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--text-main);
      margin: 24px 0 14px;
    }

    .subjects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 14px;
    }

    .subject-stat-card {
      background: var(--bg-subtle);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 16px;
    }

    .subject-stat-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 8px;
    }

    .subject-stat-score {
      font-size: 0.92rem;
      font-weight: 800;
      color: var(--text-main);
    }

    .subject-stat-sub {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-bottom: 10px;
    }

    .mini-bar-track {
      width: 100%;
      height: 8px;
      background: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
    }

    .mini-bar-fill {
      height: 100%;
      border-radius: 999px;
    }

    .fill-geo { background: #10b981; }
    .fill-hist { background: #f59e0b; }
    .fill-port { background: #3b82f6; }
    .fill-arte { background: #ec4899; }

    /* Lista de Revisão */
    .review-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .review-item {
      padding: 16px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-color);
    }

    .review-item.rev-ok {
      background: #f6fef9;
      border-color: #bbf7d0;
    }

    .review-item.rev-err {
      background: #fff8f9;
      border-color: #fecdd3;
    }

    .review-top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 8px;
    }

    .review-status {
      font-size: 0.74rem;
      font-weight: 800;
      padding: 2px 10px;
      border-radius: 999px;
      color: #ffffff;
    }

    .rev-ok .review-status { background: var(--success); }
    .rev-err .review-status { background: var(--danger); }

    .review-q {
      font-size: 0.94rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 8px;
    }

    .review-answers {
      font-size: 0.84rem;
      color: var(--text-secondary);
      margin-bottom: 6px;
    }

    .review-exp {
      font-size: 0.84rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    @media (max-width: 600px) {
      .main-card {
        padding: 20px 16px;
      }
      .question-text {
        font-size: 1.02rem;
      }
      .header-actions {
        width: 100%;
        justify-content: space-between;
      }
    }
  </style>
</head>
<body>
  <div class="app-wrapper">
    <!-- Cabeçalho -->
    <header class="header-card">
      <div class="header-top">
        <div class="brand-box">
          <div class="brand-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
          </div>
          <div>
            <h1 class="brand-title">Quiz Interativo de Revisão</h1>
            <p class="brand-subtitle">Geografia, História, Língua Portuguesa e Arte • 24 Questões</p>
          </div>
        </div>

        <div class="header-actions">
          <div class="score-pill">
            <span class="score-label">Acertos / Respondidas</span>
            <span id="score-display" class="score-value">0 / 0</span>
          </div>
          <button type="button" id="btn-shuffle" class="btn btn-soft" title="Embaralhar ordem das questões">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="16 3 21 3 21 8"></polyline>
              <line x1="4" y1="20" x2="21" y2="3"></line>
              <polyline points="21 16 21 21 16 21"></polyline>
              <line x1="15" y1="15" x2="21" y2="21"></line>
              <line x1="4" y1="4" x2="9" y2="9"></line>
            </svg>
            <span>Embaralhar</span>
          </button>
          <button type="button" id="btn-restart" class="btn btn-neutral" title="Reiniciar questionário">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="1 4 1 10 7 10"></polyline>
              <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
            </svg>
            <span>Reiniciar</span>
          </button>
        </div>
      </div>

      <!-- Abas de Filtro por Disciplina -->
      <nav id="filter-bar" class="filter-bar" aria-label="Filtrar questões por disciplina"></nav>
    </header>

    <!-- Barra de Progresso -->
    <section class="progress-section" aria-label="Progresso do questionário">
      <div class="progress-meta">
        <span id="progress-label">Questão 1 de 24</span>
        <span id="progress-percent">0% concluído</span>
      </div>
      <div class="progress-track">
        <div id="progress-bar" class="progress-fill"></div>
      </div>
    </section>

    <!-- Área Dinâmica (Questão ou Resumo Final) -->
    <main id="quiz-container" class="main-card"></main>
  </div>

  <script>
    (function () {
      'use strict';

      var OPTION_LETTERS = ['A', 'B', 'C', 'D'];
      var FILTER_TABS = [
        { key: 'Todas', label: 'Todas' },
        { key: 'Geografia', label: 'Geografia' },
        { key: 'História', label: 'História' },
        { key: 'Língua Portuguesa', label: 'Língua Portuguesa' },
        { key: 'Arte', label: 'Arte' }
      ];

      var SUBJECT_STYLES = {
        'Geografia': {
          badgeClass: 'subj-geo',
          fillClass: 'fill-geo',
          subtitle: 'Continente Africano: aspectos físicos, humanos e socioeconômicos'
        },
        'História': {
          badgeClass: 'subj-hist',
          fillClass: 'fill-hist',
          subtitle: 'Imperialismo, unificações europeias, EUA e Era Meiji'
        },
        'Língua Portuguesa': {
          badgeClass: 'subj-port',
          fillClass: 'fill-port',
          subtitle: 'Práticas de estudo, orações adverbiais, modalização e norma culta'
        },
        'Arte': {
          badgeClass: 'subj-arte',
          fillClass: 'fill-arte',
          subtitle: 'Salões de arte, concertos, ópera, sonoplastia e arranjos'
        }
      };

      var QUESTIONS_DB = [
        // ==================== GEOGRAFIA (6) ====================
        {
          id: 1,
          subject: 'Geografia',
          chapter: 'Cap. 1 — Formação Geológica e Relevo',
          question: 'A história geológica da África remonta à Era Pré-Cambriana e ao supercontinente Gondwana. Como os eventos tectônicos iniciados há cerca de 200 milhões de anos influenciaram o relevo atual do continente?',
          options: [
